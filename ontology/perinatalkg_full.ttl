loinc:9272-6 rdfs:label "1 minute Apgar Score"@en .

loinc:9274-2 rdfs:label "5 minute Apgar Score"@en .

pkg:Biome a owl:Class ;
    rdfs:label "Biome"@en,
        "Bioma"@pt ;
    rdfs:subClassOf pkg:Location .

pkg:HeatExposure a owl:Class ;
    rdfs:label "Heat Exposure"@en,
        "Exposicao ao Calor"@pt ;
    rdfs:subClassOf pkg:ClimateExposure .

pkg:Region a owl:Class ;
    rdfs:label "Region"@en,
        "Regiao"@pt ;
    rdfs:subClassOf pkg:Location .

pkg:VaginalDelivery a owl:Class ;
    rdfs:label "Vaginal Delivery"@en,
        "Parto Vaginal"@pt ;
    rdfs:subClassOf pkg:Delivery ;
    skos:closeMatch <http://hl7.org/fhir/sid/icd-10/O80> ;
    skos:exactMatch <http://snomed.info/id/48782003> .

pkg:VeryLowBirthWeight a owl:Class ;
    rdfs:label "Very Low Birth Weight"@en,
        "Muito Baixo Peso ao Nascer"@pt ;
    rdfs:subClassOf pkg:LowBirthWeight ;
    skos:closeMatch <http://hl7.org/fhir/sid/icd-10/P07.0> ;
    skos:exactMatch <http://snomed.info/id/28334000> .

