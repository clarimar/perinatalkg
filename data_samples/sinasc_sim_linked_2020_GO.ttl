<https://orcid.org/0000-0000-XXXX-XXXX> a foaf:Person ;
    foaf:mbox "clarimar@ufg.br" ;
    foaf:name "Clarimar Jose Coelho" .

<https://orcid.org/0000-0000-YYYY-YYYY> a foaf:Person ;
    foaf:name "Guilherme Coelho" .

<http://hl7.org/fhir/sid/icd-10/P07.0> rdfs:label "Extremely low birth weight newborn"@en,
        "CID-10: P07.0"@pt .

<http://hl7.org/fhir/sid/icd-10/P07.3> rdfs:label "Other preterm newborns"@en,
        "CID-10: P07.3"@pt .

pkg:LowBirthWeight a owl:Class ;
    rdfs:label "Low Birth Weight"@en,
        "Baixo Peso ao Nascer"@pt ;
    iao:0000115 "A birth in which the newborn weighs less than 2500 grams, regardless of gestational age."@en ;
    rdfs:subClassOf pkg:Birth ;
    skos:closeMatch <http://hl7.org/fhir/sid/icd-10/P07.1> ;
    skos:exactMatch <http://snomed.info/id/276610007> .

pkg:State a owl:Class ;
    rdfs:label "State"@en,
        "Estado"@pt ;
    rdfs:subClassOf pkg:Location .

pkg:Delivery a owl:Class ;
    rdfs:label "Delivery"@en,
        "Parto"@pt ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000003> .

pkg:Location a owl:Class ;
    rdfs:label "Location"@en,
        "Localizacao"@pt ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000029> .

pkg:EducationLevel a owl:Class ;
    rdfs:label "Education Level"@en,
        "Escolaridade"@pt .

pkg:Municipality a owl:Class ;
    rdfs:label "Municipality"@en,
        "Municipio"@pt ;
    rdfs:subClassOf pkg:Location .

pkg:PretermBirth a owl:Class ;
    rdfs:label "Preterm Birth"@en,
        "Nascimento Prematuro"@pt ;
    iao:0000115 "A birth that occurs before 37 completed weeks of gestation."@en ;
    rdfs:subClassOf pkg:Birth ;
    skos:closeMatch <http://hl7.org/fhir/sid/icd-10/P07> ;
    skos:exactMatch <http://snomed.info/id/395122000> .

pkg:ClimateExposure a owl:Class ;
    rdfs:label "Climate Exposure"@en,
        "Exposicao Climatica"@pt ;
    iao:0000115 "A process of exposure to climatic conditions during a specified period of gestation."@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000003> .

pkg:Mother a owl:Class ;
    rdfs:label "Mother"@en,
        "Mae"@pt ;
    iao:0000115 "A person who has given birth to a child registered in the SINASC system."@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000040> ;
    skos:exactMatch <http://snomed.info/id/303071001> .

pkg:Birth a owl:Class ;
    rdfs:label "Birth"@en,
        "Nascimento"@pt ;
    iao:0000115 "A biological process consisting in the expulsion of a fetus from the uterus, resulting in a live newborn."@en ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000003> ;
    skos:closeMatch <http://hl7.org/fhir/sid/icd-10/Z38> ;
    skos:exactMatch <http://snomed.info/id/3950001> .

pkg:LateNeonatalDeath a owl:Class ;
    rdfs:label "Late Neonatal Death"@en,
        "Óbito Neonatal Tardio"@pt ;
    rdfs:comment "Óbito entre 8-27 dias de vida"@pt ;
    rdfs:subClassOf pkg:NeonatalDeath .

pkg:EarlyNeonatalDeath a owl:Class ;
    rdfs:label "Early Neonatal Death"@en,
        "Óbito Neonatal Precoce"@pt ;
    rdfs:comment "Óbito nos primeiros 7 dias de vida"@pt ;
    rdfs:subClassOf pkg:NeonatalDeath .

pkg:NeonatalDeath a owl:Class ;
    rdfs:label "Neonatal Death"@en,
        "Óbito Neonatal"@pt ;
    rdfs:subClassOf <http://purl.obolibrary.org/obo/BFO_0000003> .

