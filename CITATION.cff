message: "If you use this ontology or dataset, please cite it as below."
type: dataset
title: "PerinatalKG: A Knowledge Graph for Perinatal Health and Climate in Brazil"
version: 0.1.0-dev
date-released: 2026-04-29
url: "https://github.com/clarimar/perinatalkg"
repository-code: "https://github.com/clarimar/perinatalkg"

authors:
  - family-names: "Coelho"
    given-names: "Clarimar José"
    email: "clarimarc@gmail.com"
    affiliation: "Federal University of Goiás"
    orcid: "https://orcid.org/0000-0000-0000-0000"
    
